AM_CPPFLAGS = -I$(top_srcdir)/include

AM_CFLAGS = -Wall -Wextra -std=c11 -nolibc -nostdlib -ffreestanding -fno-builtin -fno-stack-protector

lib_LIBRARIES = libstdoc.a
libstdoc_a_SOURCES = \
     c/io/stdoc_printf.c

AM_CXXFLAGS = -Wall -Wextra -std=c++17 -nostdlib++ -nostdlib -ffreestanding -fno-builtin -fno-stack-protector

libstdoc_a_SOURCES += \
     cxx/io/stdoc_printf.cxx

if ARCH_X86_64
libstdoc_a_SOURCES += assembly/write_x86.S
endif
if ARCH_I686
libstdoc_a_SOURCES += assembly/write_i686.S
endif
if ARCH_AARCH64
libstdoc_a_SOURCES += assembly/write_aarch64.S
endif
if ARCH_ARM32
libstdoc_a_SOURCES += assembly/write_arm32.S
endif

EXTRA_DIST = README AUTHORS NEWS ChangeLog COPYING

# Public API
include_HEADERS = \
    include/libstdoc.h \
    include/libstdoc.hpp

# C headers
libstdoc_c_ioincludedir = $(includedir)/libstdoc/c/io
libstdoc_c_ioinclude_HEADERS = \
    include/libstdoc/c/io/stdoc_printf.h

libstdoc_c_syscallincludedir = $(includedir)/libstdoc/c/syscall
libstdoc_c_syscallinclude_HEADERS = \
    include/libstdoc/c/syscall/syscall_write.h

# C++ headers
libstdoc_cxx_ioincludedir = $(includedir)/libstdoc/cxx/io
libstdoc_cxx_ioinclude_HEADERS = \
    include/libstdoc/cxx/io/stdoc_printf.hxx

libstdoc_cxx_syscallincludedir = $(includedir)/libstdoc/cxx/syscall
libstdoc_cxx_syscallinclude_HEADERS = \
    include/libstdoc/cxx/syscall/syscall_write.hxx
